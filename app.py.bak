# ==================== 2. 生成模拟趋势数据 ====================
@st.cache_data
def generate_sample_data():
    np.random.seed(42)
    months = pd.date_range(start='2020-01-01', end='2026-03-01', freq='MS')
    cpi = 100 + np.cumsum(np.random.normal(0.02, 0.25, len(months)))
    cpi = np.clip(cpi, 98, 106)
    ppi = 100 + np.cumsum(np.random.normal(-0.03, 0.4, len(months)))
    ppi = np.clip(ppi, 95, 108)
    pmi = 50 + np.cumsum(np.random.normal(0, 0.3, len(months)))
    pmi = np.clip(pmi, 46, 54)
    m2 = 10 + np.cumsum(np.random.normal(0, 0.25, len(months)))
    m2 = np.clip(m2, 7, 14)
    cpi_df = pd.DataFrame({'月份': months, '全国-当月': np.round(cpi, 2)})
    ppi_df = pd.DataFrame({'月份': months, '当月': np.round(ppi, 2)})
    pmi_df = pd.DataFrame({'月份': months, '制造业PMI': np.round(pmi, 2), '非制造业PMI': np.round(pmi + np.random.normal(0.5, 0.3, len(months)), 2)})
    m2_df = pd.DataFrame({'月份': months, 'M2-同比': np.round(m2, 2)})
    return cpi_df, ppi_df, pmi_df, m2_df

cpi_df, ppi_df, pmi_df, m2_df = generate_sample_data()

def safe_forecast(series, steps=3):
    try:
        clean = series.dropna()
        if len(clean) < 3:
            return None, "数据不足"
        diffs = clean.diff().tail(3).dropna()
        recent_diff = diffs.mean() if len(diffs) > 0 else 0
        last_val = clean.iloc[-1]
        forecast_vals = [last_val + recent_diff * (i + 1) for i in range(steps)]
        return forecast_vals, "基础趋势推算"
    except Exception:
        return None, "预测失败"

